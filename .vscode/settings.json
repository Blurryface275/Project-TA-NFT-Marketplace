{
  "solidity.packageDefaultDependenciesContractsDirectory": "contracts",
  "solidity.packageDefaultDependenciesDirectory": "contracts/lib",
  "solidity.remappings": [
    "@openzeppelin/contracts/=contracts/lib/openzeppelin-contracts/contracts/",
    "forge-std/=contracts/lib/forge-std/src/",
    "openzeppelin-contracts/=contracts/lib/openzeppelin-contracts/"
  ],
  "solidity.remappingsUnix": [
    "@openzeppelin/contracts/=contracts/lib/openzeppelin-contracts/contracts/",
    "forge-std/=contracts/lib/forge-std/src/",
    "openzeppelin-contracts/=contracts/lib/openzeppelin-contracts/"
  ],
  "solidity.compileUsingRemoteVersion": "v0.8.36",
  "solidity.defaultCompiler": "remote",
  "hardhat.solidity.configPath": "contracts/foundry.toml"
}
