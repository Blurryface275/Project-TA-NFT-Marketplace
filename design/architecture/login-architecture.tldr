              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "- Cek email di users + relations customer"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "- bcrypt.compare(password, user.password)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "- Cek user.isEmailVerified === true"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "- Query tabel organizers (Role Check)"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "- Return DTO: id, name, wallet, role"
                }
              ]
