<bpmn:collaboration id="Collaboration_1">
<bpmn:participant id="Participant_1" name="BPMN Overview - Relasi Antar Subproses" processRef="Process_1"/>
</bpmn:collaboration>
<bpmn:process id="Process_1" name="BPMN Overview - Relasi Antar Subproses" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_Pembeli" name="Pembeli">
<bpmn:flowNodeRef>start_pembeli</bpmn:flowNodeRef>
<bpmn:flowNodeRef>sp_daftar</bpmn:flowNodeRef>
<bpmn:flowNodeRef>sp_beli</bpmn:flowNodeRef>
<bpmn:flowNodeRef>gw_juallagi</bpmn:flowNodeRef>
<bpmn:flowNodeRef>sp_penukaran</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end_selesai</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end_pembeli_baru</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_Penjual" name="Penjual">
<bpmn:flowNodeRef>start_penjual</bpmn:flowNodeRef>
<bpmn:flowNodeRef>sp_event</bpmn:flowNodeRef>
<bpmn:flowNodeRef>sp_resale</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end_penjual</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start_penjual" name="Mulai"><bpmn:outgoing>Flow_start_penjual__sp_event</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="sp_event" name="Pembuatan Event (lihat Gambar 4.6.4)"><bpmn:incoming>Flow_start_penjual__sp_event</bpmn:incoming><bpmn:outgoing>Flow_sp_event__sp_beli</bpmn:outgoing></bpmn:task>
<bpmn:startEvent id="start_pembeli" name="Mulai"><bpmn:outgoing>Flow_start_pembeli__sp_daftar</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="sp_daftar" name="Pendaftaran &amp; Verifikasi Identitas (lihat Gambar 4.6.1)"><bpmn:incoming>Flow_start_pembeli__sp_daftar</bpmn:incoming><bpmn:outgoing>Flow_sp_daftar__sp_beli</bpmn:outgoing></bpmn:task>
<bpmn:task id="sp_beli" name="Pembelian Tiket (lihat Gambar 4.6.2)"><bpmn:incoming>Flow_sp_event__sp_beli</bpmn:incoming><bpmn:incoming>Flow_sp_daftar__sp_beli</bpmn:incoming><bpmn:outgoing>Flow_sp_beli__gw_juallagi</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="gw_juallagi" name="Mau dijual lagi?"><bpmn:incoming>Flow_sp_beli__gw_juallagi</bpmn:incoming><bpmn:outgoing>Flow_gw_juallagi__sp_penukaran</bpmn:outgoing><bpmn:outgoing>Flow_gw_juallagi__sp_resale</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="sp_penukaran" name="Penukaran Tiket di Venue (lihat Gambar 4.6.5)"><bpmn:incoming>Flow_gw_juallagi__sp_penukaran</bpmn:incoming><bpmn:outgoing>Flow_sp_penukaran__end_selesai</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="end_selesai" name="Selesai"><bpmn:incoming>Flow_sp_penukaran__end_selesai</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="sp_resale" name="Penjualan Kembali (Resale) (lihat Gambar 4.6.3)"><bpmn:incoming>Flow_gw_juallagi__sp_resale</bpmn:incoming><bpmn:outgoing>Flow_sp_resale__end_pembeli_baru</bpmn:outgoing><bpmn:outgoing>Flow_sp_resale__end_penjual</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="end_pembeli_baru" name="Pembeli baru terima tiket"><bpmn:incoming>Flow_sp_resale__end_pembeli_baru</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="end_penjual" name="Penjual terima dana"><bpmn:incoming>Flow_sp_resale__end_penjual</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_start_penjual__sp_event" sourceRef="start_penjual" targetRef="sp_event"/>
<bpmn:sequenceFlow id="Flow_start_pembeli__sp_daftar" sourceRef="start_pembeli" targetRef="sp_daftar"/>
<bpmn:sequenceFlow id="Flow_sp_event__sp_beli" sourceRef="sp_event" targetRef="sp_beli"/>
<bpmn:sequenceFlow id="Flow_sp_daftar__sp_beli" sourceRef="sp_daftar" targetRef="sp_beli"/>
<bpmn:sequenceFlow id="Flow_sp_beli__gw_juallagi" sourceRef="sp_beli" targetRef="gw_juallagi"/>
<bpmn:sequenceFlow id="Flow_gw_juallagi__sp_penukaran" name="tidak" sourceRef="gw_juallagi" targetRef="sp_penukaran"/>
<bpmn:sequenceFlow id="Flow_sp_penukaran__end_selesai" sourceRef="sp_penukaran" targetRef="end_selesai"/>
<bpmn:sequenceFlow id="Flow_gw_juallagi__sp_resale" name="ya" sourceRef="gw_juallagi" targetRef="sp_resale"/>
<bpmn:sequenceFlow id="Flow_sp_resale__end_pembeli_baru" sourceRef="sp_resale" targetRef="end_pembeli_baru"/>
<bpmn:sequenceFlow id="Flow_sp_resale__end_penjual" sourceRef="sp_resale" targetRef="end_penjual"/>
</bpmn:process>
